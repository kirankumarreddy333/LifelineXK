# LifelineXK Server Environment
PORT=5000

# Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/lifelinexk

# Use MongoDB Atlas for production
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/lifelinexk

JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRE=30d

NODE_ENV=development

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173

